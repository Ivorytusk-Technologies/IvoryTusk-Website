# Server Configuration
PORT=3000
NODE_ENV=production
DOMAIN=ivorytusk.co.in

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Contact Email
CONTACT_EMAIL=contact@ivorytusk.co.in
FROM_EMAIL=noreply@ivorytusk.co.in
FROM_NAME=IvoryTusk Website

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# SSL Configuration (for Let's Encrypt)
SSL_EMAIL=admin@ivorytusk.co.in
SSL_DOMAIN=ivorytusk.co.in

# LocalTunnel Configuration (Alternative to port forwarding)
TUNNEL_SUBDOMAIN=ivorytusk
USE_TUNNEL=false

# GoDaddy API for Automatic DNS Updates
GODADDY_API_KEY=your-godaddy-api-key
GODADDY_API_SECRET=your-godaddy-api-secret
DNS_RECORD_NAME=@
AUTO_UPDATE_DNS=true
TUNNEL_CHECK_INTERVAL=30000