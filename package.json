{
  "name": "ivorytusk-website",
  "version": "1.0.0",
  "description": "IvoryTusk AI Voice Agent Solutions Website",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ivorytusk-website",
    "pm2:restart": "pm2 restart ivorytusk-website",
    "pm2:logs": "pm2 logs ivorytusk-website",
    "setup-ssl": "node scripts/setup-ssl.js",
    "tunnel": "node scripts/start-tunnel.js",
    "tunnel:subdomain": "node scripts/start-tunnel.js --subdomain=ivorytusk",
    "tunnel:pm2": "pm2 start scripts/tunnel-pm2.js --name ivorytusk-tunnel",
    "tunnel:enhanced": "node scripts/enhanced-tunnel.js",
    "tunnel:enhanced:pm2": "pm2 start scripts/enhanced-tunnel.js --name ivorytusk-enhanced-tunnel",
    "tunnel:stop": "pm2 stop ivorytusk-tunnel",
    "tunnel:status": "node scripts/tunnel-status.js",
    "tunnel:urls": "node scripts/tunnel-status.js urls",
    "dns:update": "node scripts/godaddy-dns-updater.js",
    "dns:monitor": "node scripts/tunnel-monitor.js start",
    "dns:monitor:check": "node scripts/tunnel-monitor.js check",
    "dns:monitor:status": "node scripts/tunnel-monitor.js status"
  },
  "keywords": [
    "ai",
    "voice-agents",
    "website",
    "nodejs",
    "express"
  ],
  "author": "IvoryTusk",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "nodemailer": "^6.9.7",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "dotenv": "^16.3.1",
    "compression": "^1.7.4",
    "localtunnel": "^2.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}